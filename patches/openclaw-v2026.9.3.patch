+++ b/ui/src/styles/sidebar-plan-usage.css
@@ -0,0 +1,156 @@
+openclaw-sidebar-plan-usage {
+  display: block;
+  flex: 0 0 auto;
+  /* Align the utility's first heading with the sidebar's section rhythm
+     instead of leaving the header's reserved breathing room above it. */
+  margin-block-start: -24px;
+}
+
+.sidebar-plan-usage {
+  padding: 12px var(--sidebar-pad-x) 13px;
+  border-bottom: 1px solid color-mix(in srgb, var(--border) 72%, transparent);
+}
+
+.sidebar-plan-usage .context-usage__section-label {
+  color: var(--muted);
+  font-size: 11px;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  line-height: 1.2;
+  text-transform: uppercase;
+}
+
+.sidebar-plan-usage .context-usage__plan-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+}
+
+.sidebar-plan-usage .context-usage__plan-link {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  color: var(--muted);
+  text-decoration: none;
+}
+
+.sidebar-plan-usage .context-usage__plan-link:hover {
+  color: var(--text);
+}
+
+.sidebar-plan-usage .context-usage__plan-link svg {
+  width: 12px;
+  height: 12px;
+}
+
+.sidebar-plan-usage .context-usage__plan-badge {
+  color: var(--text);
+  font-size: 11px;
+  font-weight: 650;
+  letter-spacing: 0.02em;
+  text-transform: none;
+}
+
+.sidebar-plan-usage .context-usage__account,
+.sidebar-plan-usage .context-usage__provenance {
+  overflow: hidden;
+  color: var(--muted);
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.sidebar-plan-usage .context-usage__account {
+  margin-top: 4px;
+  font-size: 12px;
+}
+
+.sidebar-plan-usage .context-usage__limits {
+  display: flex;
+  flex-direction: column;
+  gap: 11px;
+  margin-top: 12px;
+}
+
+.sidebar-plan-usage .context-usage__limit-head {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 12px;
+}
+
+.sidebar-plan-usage .context-usage__limit-label {
+  overflow: hidden;
+  color: var(--text);
+  font-size: 12px;
+  font-weight: 550;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.sidebar-plan-usage .context-usage__limit-meta {
+  display: inline-flex;
+  align-items: baseline;
+  gap: 8px;
+  color: var(--muted);
+  font-size: 11px;
+  white-space: nowrap;
+}
+
+.sidebar-plan-usage .context-usage__limit-meta strong {
+  color: var(--text);
+  font-size: 12px;
+  font-weight: 650;
+  font-variant-numeric: tabular-nums;
+}
+
+.sidebar-plan-usage .context-usage__limit-bar {
+  height: 4px;
+  margin-top: 6px;
+  overflow: hidden;
+  border-radius: var(--radius-full);
+  background: color-mix(in srgb, var(--muted) 20%, transparent);
+}
+
+.sidebar-plan-usage .context-usage__limit-bar span {
+  display: block;
+  height: 100%;
+  border-radius: inherit;
+  background: var(--accent);
+}
+
+.sidebar-plan-usage .context-usage__limit-bar span.context-usage__limit-fill--safe {
+  background: var(--ok);
+}
+
+.sidebar-plan-usage .context-usage__limit-bar span.context-usage__limit-fill--warn {
+  /* The light-theme --warn token is intentionally brown for generic warnings.
+     Provider quota needs a distinct, legible yellow state. */
+  background: #ca8a04;
+}
+
+.sidebar-plan-usage .context-usage__limit-bar span.context-usage__limit-fill--danger {
+  background: var(--danger);
+}
+
+.sidebar-plan-usage .context-usage__provenance {
+  margin-top: 12px;
+  font-size: 11px;
+}
+
+.sidebar-plan-usage .context-usage__provenance strong {
+  color: var(--text);
+  font-weight: 650;
+}
+
+.sidebar-plan-usage .context-usage__plan-header ~ .context-usage__plan-header {
+  margin-top: 14px;
+  padding-top: 14px;
+  border-top: 1px solid color-mix(in srgb, var(--border) 72%, transparent);
+}
+
+.sidebar-plan-usage__unavailable {
+  margin-top: 6px;
+  color: var(--muted);
+  font-size: 12px;
+}
