@@ -1,5 +1,6 @@
 // Control UI module implements provider quota summary behavior.
 import { asDateTimestampMs } from "@openclaw/normalization-core/number-coercion";
+import type { UsageSummary } from "../../../src/infra/provider-usage.types.js";
 import type { ModelAuthStatusProvider, ModelAuthStatusResult } from "../api/types.ts";
 
 export function formatQuotaReset(resetAt?: number): string | null {
@@ -148,3 +149,68 @@ export function collectProviderQuotaGroups(
   }
   return groups.map((entry) => entry.group);
 }
+
+/**
+ * Projects the unscoped usage.status payload onto the same display contract as
+ * the auth-status usage embed. The sidebar uses this boundary so it never
+ * needs provider credentials or provider-specific transport knowledge.
+ */
+export function collectProviderQuotaGroupsFromUsageSummary(
+  summary: UsageSummary | null,
+): ProviderQuotaGroup[] {
+  const groups: Array<{ identity: string; group: ProviderQuotaGroup }> = [];
+  for (const snapshot of summary?.providers ?? []) {
+    const windows: QuotaLimitSummary[] = snapshot.windows.map((limit) => ({
+      label: limit.label.trim(),
+      usedPercent: clampPercent(limit.usedPercent),
+      ...(limit.resetAt !== undefined ? { resetAt: limit.resetAt } : {}),
+    }));
+    const budgets: QuotaBudgetSummary[] = (snapshot.billing ?? []).flatMap((entry) => {
+      if (
+        entry.type !== "budget" ||
+        !Number.isFinite(entry.used) ||
+        !Number.isFinite(entry.limit) ||
+        entry.used < 0 ||
+        entry.limit <= 0
+      ) {
+        return [];
+      }
+      return [
+        {
+          ...(entry.label ? { label: entry.label } : {}),
+          used: entry.used,
+          limit: entry.limit,
+          unit: entry.unit,
+        },
+      ];
+    });
+    if (windows.length === 0 && budgets.length === 0) {
+      continue;
+    }
+    const identity = JSON.stringify([
+      snapshot.displayName,
+      snapshot.accountEmail ?? null,
+      windows,
+      budgets,
+    ]);
+    const existing = groups.find((entry) => entry.identity === identity);
+    if (existing) {
+      if (!existing.group.providers.includes(snapshot.provider)) {
+        existing.group.providers.push(snapshot.provider);
+      }
+      continue;
+    }
+    groups.push({
+      identity,
+      group: {
+        providers: [snapshot.provider],
+        displayName: snapshot.displayName,
+        ...(snapshot.plan ? { plan: snapshot.plan } : {}),
+        ...(snapshot.accountEmail ? { accountEmail: snapshot.accountEmail } : {}),
+        windows,
+        budgets,
+      },
+    });
+  }
+  return groups.map((entry) => entry.group);
+}
